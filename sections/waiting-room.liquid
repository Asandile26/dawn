{%- assign welcome_message = section.settings.heading -%}
{% if customer %}
  {%- assign welcome_message = 'Welcome back, '
    | append: customer.first_name
    | append: '! '
    | append: section.settings.heading
  -%}
{% endif %}

<div
  class="waiting-room-container page-width"
  id="WaitingRoom-{{ section.id }}"
  data-customer-id="{{ customer.id | default: 'guest' }}"
  data-wait-time="{{ section.settings.wait_minutes }}"
>
  <!-- Header & Live Status -->
  <div class="waiting-room-header">
    <span class="badge-live">LIVE QUEUE</span>
    <h2>{{ welcome_message }}</h2>
    <p>
      {{ section.settings.subheading }}
      <strong><span id="queue-timer-text">--:--</span></strong>
    </p>
  </div>

  <!-- 1. Progress Bar Component -->
  <div class="queue-progress-wrapper">
    <div class="progress-info-row">
      <span>Queue Position: <strong id="queue-spot-text">Calculating...</strong></span>
      <span id="queue-percent-text">0% Complete</span>
    </div>

    <div class="custom-progress" role="progressbar" aria-label="Waiting Room Progress">
      <div class="custom-progress-bar" id="waiting-room-progress-bar" style="width: 0%;"></div>
    </div>
  </div>

  <div class="waiting-room-grid">
    <!-- 2. Travel Choices Profile -->
    <div class="grid-card">
      <div class="card-header">
        <h3>Step 1: Your Travel Profile</h3>
        <p>This helps us customize your plan while you wait.</p>
      </div>
      <form id="travel-profile-form">
        <div class="form-group">
          <label class="group-label">Ideal Travel Vibe</label>
          <div class="vibe-chips">
            {% assign vibes = 'Relaxing,Adventure,Culture' | split: ',' %}
            {% for vibe in vibes %}
              <label class="chip">
                <input
                  type="radio"
                  name="travel_vibe"
                  value="{{ vibe }}"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                >
                <span>{{ vibe }}</span>
              </label>
            {% endfor %}
          </div>
        </div>

        <div class="form-group">
          <label for="travel_budget" class="group-label">Target Budget (per person)</label>
          <select id="travel_budget" name="travel_budget" class="select-input">
            {% comment %} Range: 1,000 to 2,500 {% endcomment %}
            <option class="budgets" value="1000-2500">
              {{ 100000 | money_without_trailing_zeros }} – {{ 250000 | money_without_trailing_zeros }}
            </option>

            {% comment %} Range: 2,500 to 5,000 {% endcomment %}
            <option class="budgets" value="2500-5000" selected>
              {{ 250000 | money_without_trailing_zeros }} – {{ 500000 | money_without_trailing_zeros }}
            </option>

            {% comment %} Range: 5,000+ {% endcomment %}
            <option class="budgets" value="5000+">{{ 500000 | money_without_trailing_zeros }}+ ({{ 'Luxury' }})</option>
          </select>
        </div>
      </form>
    </div>

    <!-- 3. Standby Checklist -->
    <div class="grid-card">
      <div class="card-header">
        <h3>Step 2: Claim Readiness</h3>
        <p>Complete these to ensure a smooth checkout.</p>
      </div>
      <ul class="standby-list" id="standby-checklist">
        <li>
          <label class="check-item">
            <input type="checkbox" id="check-passport">
            <div>
              <strong>Passport Verified</strong>
              <span>Valid for 6+ months.</span>
            </div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="check-payment">
            <div>
              <strong>Payment Ready</strong>
              <span>Cards or Apple/Google Pay handy.</span>
            </div>
          </label>
        </li>
      </ul>
    </div>
  </div>

  <!-- Primary Call To Action -->
  <div class="checkout-bar">
    <button id="queue-submit-btn" class="btn-checkout-disabled" disabled>
      <span id="btn-label">Waiting for your spot...</span>
    </button>
    <p id="checklist-reminder" style="font-size: 0.8rem; margin-top: 10px; color: #dc2626; display: none;">
      Please complete the checklist above to enable checkout.
    </p>
  </div>
</div>

{% style %}
  .waiting-room-container {
    max-width: 1140px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: inherit;
  }

  .waiting-room-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .badge-live {
    background-color: #fee2e2;
    color: #dc2626;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 12px;
    letter-spacing: 0.5px;
  }

  .waiting-room-header h2 {
    margin: 12px 0 6px;
    font-size: 1.75rem;
    color: #0f172a;
  }

  .waiting-room-header p {
    margin: 0;
    color: #64748b;
  }

  /* Progress Bar */
  .queue-progress-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
  }

  .progress-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: #334155;
    margin-bottom: 8px;
  }

  .custom-progress {
    height: 14px;
    background-color: #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
  }

  .custom-progress-bar {
    height: 100%;
    background-color: #2563eb;
    transition: width 0.4s ease-in-out;
  }

  /* Two Column Grid */
  .waiting-room-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  @media (max-width: 768px) {
    .waiting-room-grid {
      grid-template-columns: 1fr;
    }
  }

  .grid-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .card-header h3 {
    margin: 0 0 4px;
    font-size: 1.4rem;
    font-weight: 600;
    color: #100203;
  }

  .card-header p {
    margin: 5px 0 16px;
    font-size: 1.2rem;
    font-weight: 400;
    color: #100203;
  }

  .form-group {
    margin-bottom: 14px;
  }

  .group-label {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: #100203;
    margin-bottom: 6px;
  }

  .vibe-chips {
    display: flex;
    gap: 8px;
  }

  .chip input {
    display: none;
  }

  .chip span {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 18px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    color: #100203;
  }

  .chip input:checked + span {
    background-color: #2563eb;
    color: #fff;
    border-color: #2563eb;
  }

  .select-input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
  }

  /* Standby List */
  .standby-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .check-item {
    display: flex;
    gap: 10px;
    cursor: pointer;
  }

  .check-item input {
    margin-top: 3px;
    accent-color: #2563eb;
  }

  .check-item strong {
    display: block;
    font-size: 0.9rem;
    color: #1e293b;
  }

  .check-item span {
    font-size: 0.8rem;
    color: #64748b;
  }

  /* CTA Bar */
  .checkout-bar {
    text-align: center;
  }

  .btn-checkout-disabled {
    width: 100%;
    padding: 16px;
    background-color: #94a3b8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: not-allowed;
    transition: all 0.3s ease;
  }

  .btn-checkout-active {
    width: 100%;
    padding: 16px;
    background-color: #16a34a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    /* animation: pulse 1.5s infinite; */
  }

  /* @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.01);
    }
    100% {
      transform: scale(1);
    }
  } */
  .budgets {
    font-size: 1.2rem;
    font-weight: 600;
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('WaitingRoom-{{ section.id }}');
    const waitMinutes = parseInt(container.dataset.waitTime) || 2;

    // UI Elements
    const progressBar = document.getElementById('waiting-room-progress-bar');
    const timerText = document.getElementById('queue-timer-text');
    const submitBtn = document.getElementById('queue-submit-btn');
    const checklistInputs = document.querySelectorAll('#standby-checklist input');

    // 1. Persistence Logic: Check if they were already waiting
    const startTimeKey = 'queue_start_time_{{ section.id }}';
    let startTime = localStorage.getItem(startTimeKey);

    if (!startTime) {
      startTime = Date.now();
      localStorage.setItem(startTimeKey, startTime);
    }

    function updateQueue() {
      const elapsedMs = Date.now() - startTime;
      const totalMs = waitMinutes * 60 * 1000;
      let progress = (elapsedMs / totalMs) * 100;
      let remainingSecs = Math.max(0, Math.floor((totalMs - elapsedMs) / 1000));

      if (progress >= 100) {
        progress = 100;
        remainingSecs = 0;
        completeQueue();
        clearInterval(queueInterval);
      }

      // Update UI
      progressBar.style.width = progress + '%';
      document.getElementById('queue-percent-text').textContent = Math.round(progress) + '% Complete';

      const mins = Math.floor(remainingSecs / 60);
      const secs = remainingSecs % 60;
      timerText.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      const spots = Math.max(1, Math.ceil(20 * (1 - progress / 100)));
      document.getElementById('queue-spot-text').textContent = `#${spots} in line`;
    }

    const queueInterval = setInterval(updateQueue, 1000);
    updateQueue();
    container.classList.add('loaded');

    function completeQueue() {
      submitBtn.disabled = false;
      submitBtn.className = 'btn-checkout-active';
      document.getElementById('btn-label').textContent = 'CLAIM SPOT & CHECKOUT';
    }

    // 2. Checklist enforcement
    function checkReadiness() {
      const allChecked = Array.from(checklistInputs).every((i) => i.checked);
      if (allChecked && progressBar.style.width === '100%') {
        submitBtn.disabled = false;
        document.getElementById('checklist-reminder').style.display = 'none';
      } else if (progressBar.style.width === '100%') {
        submitBtn.disabled = true;
        document.getElementById('checklist-reminder').style.display = 'block';
      }
    }
    checklistInputs.forEach((input) => input.addEventListener('change', checkReadiness));

    // 3. Sync Profile to Shopify Cart Attributes
    const profileForm = document.getElementById('travel-profile-form');
    profileForm.addEventListener('change', function () {
      const formData = new FormData(profileForm);
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          attributes: {
            Vibe: formData.get('travel_vibe'),
            Budget: formData.get('travel_budget'),
          },
        }),
      });
    });

    submitBtn.addEventListener('click', () => {
      window.location.href = '/checkout';
    });
  });
</script>

{% schema %}
{
  "name": "Waiting Room",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You're in line for your Travel Plan!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Please keep this page open. Estimated wait:"
    },
    {
      "type": "range",
      "id": "wait_minutes",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "min",
      "label": "Wait Duration",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Waiting Room"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Renders an interactive queue progress bar with live polling / streaming support.

  Accepts:
  - initial_position: {Number} Optional estimated initial position in queue.
  - queue_id: {String} Unique queue identifier passed from backend/session.
{%- endcomment -%}

<div
  class="queue-container"
  data-queue-wrapper
  data-queue-id="{{ queue_id | default: '' }}"
>
  <div class="queue-card">
    <!-- Header / Status Badge -->
    <div class="queue-header">
      <div class="queue-status-badge">
        <span class="pulse-dot"></span>
        <span class="queue-status-text" data-queue-status-text>Connecting to Queue...</span>
      </div>
      <span class="queue-badge-label">Live Queue</span>
    </div>

    <!-- Main Live Stats -->
    <div class="queue-stats">
      <div class="stat-group">
        <span class="stat-label">Your Position</span>
        <span class="stat-value" data-queue-position>--</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-group">
        <span class="stat-label">Estimated Wait</span>
        <span class="stat-value" data-queue-wait>--</span>
      </div>
    </div>

    <!-- Progress Bar Track & Fill -->
    <div
      class="queue-bar-track"
      role="progressbar"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax="100"
      data-queue-progress-track
    >
      <div class="queue-bar-fill" data-queue-progress-fill style="width: 0%;">
        <div class="queue-bar-glow"></div>
      </div>
    </div>

    <!-- Dynamic Message Footer -->
    <div class="queue-footer">
      <p class="queue-message" data-queue-message>Please hold tight. Do not refresh or close this browser window.</p>
    </div>
  </div>
</div>
<style>
  .queue-container {
    width: 100%;
    max-width: 520px;
    margin: 1.5rem auto;
    font-family: inherit;
  }

  .queue-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .queue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .queue-status-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-ring 1.6s infinite cubic-bezier(0.66, 0, 0, 1);
  }

  @keyframes pulse-ring {
    to {
      box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
    }
  }

  .queue-badge-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: #f1f5f9;
    color: #64748b;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    font-weight: 600;
  }

  .queue-stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: #f8fafc;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .stat-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
  }

  .stat-divider {
    width: 1px;
    height: 30px;
    background-color: #e2e8f0;
  }

  /* Progress Track */
  .queue-bar-track {
    width: 100%;
    height: 12px;
    background-color: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
  }

  .queue-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #3b82f6);
    border-radius: 9999px;
    width: 0%;
    transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }

  .queue-bar-glow {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20px;
    background: rgba(255, 255, 255, 0.4);
    filter: blur(2px);
  }

  .queue-footer {
    margin-top: 1rem;
    text-align: center;
  }

  .queue-message {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }
</style>
